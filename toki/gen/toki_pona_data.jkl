FN TokiAlternate (
    IN c : UBYTE,
) : UBYTE
    IF c == 129 THEN RETURN 19 END
    IF c == 188 THEN RETURN 18 END
    IF c == 218 THEN RETURN 17 END
    RETURN c
END

#DEFINE TOKI_CARTOUCHE_OPEN 27
#DEFINE TOKI_CARTOUCHE_CLOSE 28
#DEFINE TOKI_PI_EXTENDED 29
#DEFINE TOKI_DOT 30
#DEFINE TOKI_COLON 31

FN TokiGetPunct (
    IN c : UBYTE,
) : UBYTE
    IF c == '[' THEN RETURN TOKI_CARTOUCHE_OPEN
    ELSEIF c == ']' THEN RETURN TOKI_CARTOUCHE_CLOSE
    ELSEIF c == '_' THEN RETURN TOKI_PI_EXTENDED
    ELSEIF c == '.' THEN RETURN TOKI_DOT
    ELSEIF c == ':' THEN RETURN TOKI_COLON
    ELSE RETURN c END
END


FN TokiEncodingToTileIndex (
    IN encoding : UBYTE,
) : UBYTE
    IF 1 <= encoding AND encoding <= 9 THEN
        RETURN (encoding + 127) & 255
    END
    IF 11 <= encoding AND encoding <= 19 OR 27 <= encoding AND encoding <= 31 THEN
        RETURN (encoding + 126) & 255
    END
    IF 128 <= encoding AND encoding <= 255 THEN
        RETURN (encoding - 128) & 255
    END
    RETURN 255
END


FN TokiIsValidChar (
    IN c : UBYTE,
) : UBYTE
    RETURN c == 'a' OR c == 'e' OR c == 'i' OR c == 'j' OR c == 'k' OR c == 'l' OR c == 'm' OR c == 'n' OR c == 'o' OR c == 'p' OR c == 's' OR c == 't' OR c == 'u' OR c == 'w'
END

